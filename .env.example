# ====== Pengaturan ShopKuy ======
# Salin file ini menjadi .env lalu sesuaikan nilainya.

# Database (dipakai container Postgres & app)
POSTGRES_USER=shopkuy
POSTGRES_PASSWORD=ganti-password-kuat
POSTGRES_DB=shopkuy

# Keamanan login admin
JWT_SECRET=ganti-string-acak-panjang
ADMIN_EMAIL=admin@shopkuy.id
ADMIN_PASSWORD=ganti-password-admin

# Port aplikasi di host
PORT=3000
